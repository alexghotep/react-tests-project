# https://editorconfig.org
root = true

# Базовые правила для абсолютно всех файлов проекта
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Фронтенд (TypeScript, React JSX, JavaScript)
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 4

# Конфиги, манифесты и данные (обычно 2 пробела)
[*.{json,json5,webmanifest}]
indent_style = space
indent_size = 2

# Стили (CSS, SCSS)
[*.{css,scss,sass,less}]
indent_style = space
indent_size = 2

# Разметка и векторная графика
[*.{html,xml,svg}]
indent_style = space
indent_size = 2

# Документация Markdown (хвостовые пробелы не обрезаем, в MD два пробела на конце — это перенос строки <br>)
[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

# YAML конфиги (строго 2 пробела по стандарту)
[*.{yml,yaml}]
indent_style = space
indent_size = 2